# AquaSafe Environment Configuration Example
# Copy this file to .env or set environment variables accordingly

# Server Port
PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aquasafe
DB_USER=root
DB_PASSWORD=root

# Fallback in-memory database enabled if MySQL service is not reachable
DB_FALLBACK_H2=true

# Real-time Weather API (Optional - Open-Meteo free public API used by default with no key required)
# If using a paid/key-based provider like OpenWeatherMap, set:
WEATHER_API_KEY=
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Spark & Hadoop Integration (Optional - Local DataProcessing fallback active when offline)
SPARK_MASTER=local[*]
HADOOP_HDFS_URI=hdfs://localhost:9000

# Security / JWT / Session
JWT_SECRET=aquasafe_super_secret_jwt_key_2026_water_borne_disease_risk_analytics
